# Copy to .env and fill in. .env is gitignored; keys are NEVER written into source code.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)
SAFESCHOOL_MODEL=claude-sonnet-5
SAFESCHOOL_LLM_PROVIDER=anthropic     # anthropic | mock
SAFESCHOOL_CORPUS_DIR=../disser/prepared
SAFESCHOOL_MATRIX_CSV=../disser/matrix_literature.csv
SAFESCHOOL_MAX_STEPS=40
SAFESCHOOL_DEADLINE_SECONDS=300
